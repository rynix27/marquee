# ClickHouse Cloud (or self-hosted) connection
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Gemini / Google Cloud
# Option A: API key (simplest for local dev)
GOOGLE_API_KEY=your-gemini-api-key

# Option B: Vertex AI (used in production / Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# App
FILM_TITLE="Midnight Fracture"
PORT=8080

# Optional: require an X-API-Key header on /chat and /replay-scenario.
# Leave unset for the original open/demo-friendly behavior.
# MARQUEE_API_KEY=some-long-random-string

# Optional: per-client-IP requests/minute cap on /chat and /replay-scenario
# (simple in-memory limiter, resets on restart). Defaults to 30.
# MARQUEE_RATE_LIMIT_PER_MINUTE=30

# Optional: override the TTS model/voice used for critical alert announcements
# (see backend/tts.py — defaults are usually fine, only change if Google
# documents a different current model name)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
